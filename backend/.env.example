# =====================================================================
# ARIX BACKEND - Variables de entorno (PLANTILLA)
# Copia este archivo como ".env" y ajusta los valores reales.
# =====================================================================

# --- Aplicación ---
APP_NAME=ARIX Backend
APP_ENV=development
DEBUG=True

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arix_db
DB_USER=root
DB_PASSWORD=root

# --- JWT ---
JWT_SECRET_KEY=ARIX_SUPER_SECRET_KEY_CAMBIAR_EN_PRODUCCION_1234567890ABCDEF
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Archivos / uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
